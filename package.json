{
  "name": "@lulu38m/spider-crawler",
  "version": "0.1.0",
  "description": "A literal web crawler: drop a document, watch a spider read it, get the gist.",
  "keywords": [
    "spider",
    "summarizer",
    "summary",
    "pdf",
    "tldr",
    "canvas",
    "procedural-animation",
    "inverse-kinematics",
    "textrank",
    "creative-coding",
    "web-crawler"
  ],
  "homepage": "https://lulu38m.github.io/spider-crawler/",
  "bugs": {
    "url": "https://github.com/lulu38m/spider-crawler/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lulu38m/spider-crawler.git"
  },
  "author": "Lucas Moreau",
  "license": "MIT",
  "type": "module",
  "bin": {
    "spider-crawler": "bin/spider-crawler.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "server/api.mjs",
    "server/api.d.mts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:render": "node scripts/render-demo.mjs",
    "start": "node bin/spider-crawler.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@types/node": "^22.20.5",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
